# Match these values to the host user that owns the bind-mounted directories.
# Check them with: id -u && id -g
USER_UID=1000
USER_GID=1000

# Version embedded into the source-built code-server release.
CODE_SERVER_VERSION=4.131.0

# Host port exposed by Docker Compose.
CODE_SERVER_PORT=8080

# Replace this value before starting the service.
CODE_SERVER_PASSWORD=change-me
